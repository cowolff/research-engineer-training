# Local dev only — atlasflow doesn't read this file. Set real env vars
# in the atlasflow dashboard instead, under the project's Runtime
# Variables (not Build Variables — see README → "Environment variables
# on atlasflow" for why that distinction matters).

# Uncomment to run on a different port locally. Defaults to 3000 to
# match what atlasflow requires — see README → "Deploying to atlasflow".
# PORT=3000

# --- Required in any real deployment (Runtime Variables) --------------------
# SECRET_KEY=change-me-to-something-random-and-stable
# MISTRAL_API_KEY=

# --- Local development convenience ------------------------------------------
# `fake` needs no API key, makes no network calls, and is what the test
# suite runs against. `mistral` calls Mistral's own SDK directly (needs
# MISTRAL_API_KEY). `litellm` routes through LiteLLM instead, which can point
# at Mistral, OpenAI, Anthropic, Azure, Bedrock, or a local model without any
# code change — see LITELLM_MODEL below.
LLM_PROVIDER=litellm

# Only read when LLM_PROVIDER=litellm. Uses LiteLLM's "provider/model"
# naming (https://docs.litellm.ai/docs/providers) — LiteLLM resolves that
# backend's own API key from the environment itself (MISTRAL_API_KEY,
# OPENAI_API_KEY, ANTHROPIC_API_KEY, ...). Only set LITELLM_API_KEY if your
# backend doesn't map to one of those well-known names.
# LITELLM_MODEL=
# LITELLM_API_KEY=

# A self-hosted backend like hosted_vllm/ has no public URL LiteLLM can
# guess — this is the LiteLLM URL. Two ways to set it, pick one:
#   1. The provider-specific env var LiteLLM already reads on its own —
#      for hosted_vllm/ that's HOSTED_VLLM_API_BASE (ollama/ uses
#      OLLAMA_API_BASE, lm_studio/ uses LM_STUDIO_API_BASE, etc.):
# HOSTED_VLLM_API_BASE=http://your-vllm-host:8000/v1
#   2. LITELLM_API_BASE — a generic override this app passes through
#      explicitly, for when you'd rather not look up the per-provider name.
#      Wins over HOSTED_VLLM_API_BASE if both are set.
# LITELLM_API_BASE=http://your-vllm-host:8000/v1

# A fast commercial API answers well within the 45s default. A self-hosted
# or "thinking"/reasoning model can genuinely need much longer — each retry
# (2 by default) waits up to this long again, so raising it multiplies into
# a longer worst-case job duration, not a longer request (jobs run
# off-request in a background thread — see IMPLEMENTATION_PLAN.md §3).
# LLM_TIMEOUT_SECONDS=45

# Unset by default — each provider/model's own default temperature is used.
# Lower values trade creativity for consistency, which matters more for
# "follow this exact JSON field structure" than for open-ended prose; a
# smaller self-hosted model in particular may need this turned down to
# reliably hit the requested schema instead of drifting to plausible-but-wrong
# field names. Applies to both providers.
# LLM_TEMPERATURE=0.6

# A bare `flask run` has no TLS. atlasflow always terminates TLS upstream in
# production, so Secure cookies are correct and required there — but over
# plain http://, a spec-compliant client will refuse to send a Secure
# cookie, which silently breaks login. Only set this to false for local dev.
SESSION_COOKIE_SECURE=false

# Deliberately NOT set here, even for local dev. Flask's CLI auto-loads this
# .env file on EVERY `flask` command — including `flask db upgrade` and
# `flask seed-curriculum` — regardless of what your shell already has
# exported, so baking RUN_BACKGROUND_WORKER=1 into this file would make it
# reap jobs from (and on a fresh clone, crash against) a database those
# commands haven't finished setting up yet. Set it inline, only on the
# command that actually serves traffic:
#   RUN_BACKGROUND_WORKER=1 flask run --debug
# This is exactly what docker-entrypoint.sh does for the real deployment,
# for the same reason — see IMPLEMENTATION_PLAN.md §11.
# RUN_BACKGROUND_WORKER=1

# Comma-separated list; matching emails get role=instructor on login.
# INSTRUCTOR_EMAILS=you@example.com

# Where SQLite lives locally (falls back to /tmp if unwritable).
SQLITE_PATH=./instance/dev.db

# Add real secrets (API keys, DATABASE_URL, ...) here as this app grows,
# following the same NAME= convention. Never commit a filled-in .env —
# it's gitignored on purpose.
